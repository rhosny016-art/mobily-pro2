rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin emails allowed to manage the dashboard.
    // MUST stay in sync with VITE_ADMIN_EMAILS in the client build.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          "abdo01554671424@gmail.com"
        ];
    }

    // ---- Field-size guards for public write paths ----
    function isString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function isContactRequest(data) {
      return data.keys().hasOnly(['id', 'name', 'email', 'phone', 'subject', 'message', 'status', 'created_date'])
        && isString(data.name, 120) && data.name.size() >= 1
        && isString(data.email, 160)
        && (!('phone' in data) || isString(data.phone, 30))
        && (!('subject' in data) || isString(data.subject, 200))
        && isString(data.message, 4000)
        && isString(data.created_date, 64);
    }

    function isVisit(data) {
      return data.keys().hasOnly(['page', 'visitor_id', 'referrer', 'created_date'])
        && isString(data.page, 200)
        && isString(data.visitor_id, 80)
        && (!('referrer' in data) || isString(data.referrer, 500))
        && isString(data.created_date, 64);
    }

    // Site Settings — public content, admin-only writes
    match /site_settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Service Overrides — public content, admin-only writes
    match /service_overrides/{overrideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact Requests — contains PII (name, phone, email).
    // Anyone may create one, but only admins can read/update/delete.
    match /contact_requests/{requestId} {
      allow create: if isContactRequest(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Visits — anonymous analytics, admin-only reads
    match /visits/{visitId} {
      allow create: if isVisit(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
