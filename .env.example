# Optional overrides — the app works out of the box using firebase-applet-config.json.
# Copy to .env or .env.local and fill in to override Firebase / admin settings.

# Public canonical origin, without a trailing slash. This must be the live production domain.
VITE_SITE_URL=https://dalni-agency.vercel.app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Comma-separated emails allowed to access the dashboard.
# Keep in sync with the isAdmin() list in firestore.rules.
VITE_ADMIN_EMAILS=
